import { GoogleGenAI } from '@google/genai';
import Replicate from 'replicate';

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { script } = req.body;
  if (!script) {
    return res.status(400).json({ error: 'Thiếu kịch bản đầu vào' });
  }

  try {
    // 1. Dùng Gemini để phân tích kịch bản ra Visual Prompt
    const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });
    const promptResponse = await ai.models.generateContent({
      model: 'gemini-2.5-flash',
      contents: `Phân tích kịch bản sau và trả về 1 câu Prompt tiếng Anh ngắn gọn mô tả hình ảnh/video để đưa vào AI Text-to-Video: "${script}"`,
    });
    const videoPrompt = promptResponse.text.trim();

    // 2. Gọi Replicate API để sinh Video (Ví dụ model Wan2.1 hoặc CogVideoX)
    const replicate = new Replicate({
      auth: process.env.REPLICATE_API_TOKEN,
    });

    // Tạo dự đoán (Prediction)
    const prediction = await replicate.predictions.create({
      // Dùng model Wan2.1 hoặc AnimateDiff/CogVideoX trên Replicate
      version: "9f7709c00b0... (ID phiên bản model trên Replicate)",
      input: {
        prompt: videoPrompt,
        frames: 16,
        fps: 8
      }
    });

    // Trả kết quả Prediction ID về cho Frontend để theo dõi tiến độ
    return res.status(200).json({ 
      success: true, 
      predictionId: prediction.id,
      promptUsed: videoPrompt 
    });

  } catch (error) {
    console.error(error);
    return res.status(500).json({ error: error.message });
  }
}